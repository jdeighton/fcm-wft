# Copy to %USERPROFILE%\.wft\<env>.env (e.g. uat.env, prod.env). Never commit real env files.
# Values are checked so a uat.env can't point at prod (or vice versa): generic rules in the repo's
# config/environments.yaml, plus the firm's own patterns in environments.yaml next to this file (optional,
# same format, never committed). Put patterns for the real share paths and URLs there, not in the repo.

# Required. Root folder on the shared drive for this environment.
# The folder must contain meta\environment holding the environment name (prod or uat).
WFT_SHARE_ROOT=\\server\share\wft\uat

# Optional. Preferred local port for the web UI (default 8765). If it's in use a free port is chosen.
WFT_PORT=8765

# Development only. Run unpublished definitions straight from a repo folder instead of
# the versions published to the share (e.g. C:\src\fcm-wft\definitions). Leave unset normally.
# WFT_DEFINITIONS_DIR=

# Optional. TT REST API (read-only: picklists, pre-filling forms, verify steps). Leave unset to type values by hand.
# Use your OWN app key and secret for this environment; they never leave this file.
# Set WFT_TT_BASE_URL=fake: to try WFT with sample TT data and no TT access.
# WFT_TT_BASE_URL=https://ttrestapi.trade.tt
# WFT_TT_ENVIRONMENT=ext_uat_cert
# WFT_TT_APP_KEY=
# WFT_TT_APP_SECRET=
# WFT_TT_APP_NAME=WFT
# WFT_TT_COMPANY=
# How long cached accounts/users lists are used before asking TT again (default 60).
# WFT_TT_CACHE_MINUTES=60

# Optional. How WFT tells you about changes while it's running:
#   windows - desktop toasts from WFT itself (default on Windows)
#   browser - your browser's notifications, while a WFT tab is open (enable them on the Notifications page)
#   off     - only the count in WFT
# WFT_NOTIFICATIONS=windows
