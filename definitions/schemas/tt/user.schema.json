{
  "$comment": "DRAFT TT add-user capture form. Confirm fields against the paper form and TT data dictionary before use (#15).",
  "type": "object",
  "required": ["first_name", "last_name", "email", "accounts"],
  "properties": {
    "first_name": {"type": "string", "minLength": 1, "title": "First name"},
    "last_name": {"type": "string", "minLength": 1, "title": "Last name"},
    "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$", "x-pattern-message": "Enter an email address", "title": "Email"},
    "company": {"type": "string", "title": "Company"},
    "accounts": {
      "type": "array", "minItems": 1, "title": "Account access",
      "items": {"type": "object", "required": ["account", "access"], "properties": {
        "account": {"type": "string", "title": "Account", "x-picklist": "tt.accounts"},
        "access": {"type": "string", "enum": ["trade", "view"], "title": "Access"}
      }}
    },
    "markets": {"type": "array", "title": "Exchanges / trader IDs", "items": {"type": "object", "properties": {
      "exchange": {"type": "string", "title": "Exchange"},
      "trader_id": {"type": "string", "title": "Trader ID"}
    }}}
  }
}
