{
  "$comment": "DRAFT TT limit-change capture form, shaped for the KRM22 upload (one row per product; see mappings/krm22/tt_limit_upload.mapping.yaml). Confirm against the TT data dictionary before use (#14); product pickers come with #36.",
  "type": "object",
  "required": ["account", "products"],
  "properties": {
    "account": {"type": "string", "title": "TT account", "x-picklist": "tt.accounts", "minLength": 1},
    "products": {
      "type": "array", "minItems": 1, "title": "Products",
      "items": {
        "type": "object",
        "required": ["exchange", "family", "type", "product", "action"],
        "properties": {
          "exchange": {"type": "string", "title": "Exchange"},
          "family": {"type": "string", "title": "Family"},
          "type": {"type": "string", "title": "Type", "enum": ["Future", "Spread", "Option"]},
          "product": {"type": "string", "title": "Product"},
          "action": {"type": "string", "title": "Action", "enum": ["add", "change", "remove"]},
          "max_order_qty": {"type": "integer", "minimum": 1, "title": "Max order quantity"},
          "max_position": {"type": "integer", "minimum": 1, "title": "Max position (net)"}
        }
      }
    },
    "justification": {"type": "string", "maxLength": 2000, "title": "Justification"}
  }
}
